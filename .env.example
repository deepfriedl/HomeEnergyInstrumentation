# Copy to .env and replace every value before first launch. Do not commit .env.
ENERGY_ADMIN_USERNAME=replace-with-private-login-name
ENERGY_INITIAL_PASSWORD=choose-a-long-unique-password
ENERGY_SESSION_SECRET=replace-with-a-long-random-secret
ENERGY_BIND_ADDRESS=192.168.1.100
# Optional: used only by the one-time, read-only Lennox discovery command.
ENERGY_LENNOX_HOST=192.168.1.110
# Optional: National Weather Service station identifier for independent local weather.
ENERGY_NWS_STATION=replace-with-station-id
# Optional: Bambu printer LAN telemetry. Keep all three values private.
ENERGY_BAMBU_HOST=replace-with-printer-ip
ENERGY_BAMBU_SERIAL=replace-with-printer-serial
ENERGY_BAMBU_ACCESS_CODE=replace-with-lan-access-code
ENERGY_BAMBU_POWER_DEVICE_NAME=replace-with-shelly-device-name
